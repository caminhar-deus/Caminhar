{
  "name": "caminhar",
  "version": "1.4.0",
  "description": "Plataforma web de conteúdo católico com Next.js",
  "type": "module",
  "engines": {
    "node": "24.22.0",
    "npm": "11.19.1"
  },
  "scripts": {
    "check-env": "node scripts/check-env.js",
    "dev": "npm run check-env && next dev",
    "build": "npm run check-env && next build",
    "postbuild": "next-sitemap",
    "sitemap": "next-sitemap",
    "start": "npm run check-env && next start",
    "dev:clean": "npx kill-port 3000 && rm -rf .next && rm -f babel.config.js babel.config.cjs && npm run dev",
    "analyze": "next build --analyze",
    "lint": "eslint .",
    "lint:log": "node scripts/diagnostics/run-with-log.js logs/eslint.log -- eslint .",
    "lint:fix": "eslint . --fix",
    "lint:workflows": "bash scripts/diagnostics/lint-workflows.sh",
    "lint:chars": "node scripts/diagnostics/lint-chars.js",
    "bench:orch:rodar": "node scripts/bench/orchestrator/rodar.js",
    "bench:orch:conferir": "node scripts/bench/orchestrator/conferir.js",
    "knip": "knip",
    "knip:watch": "knip --watch",
    "models:check": "node scripts/diagnostics/check-model-catalog.js",
    "diag:actions": "node scripts/diagnostics/check-github-actions.js",
    "diag:actions:snapshot": "node scripts/diagnostics/check-github-actions.js --write-snapshot logs/github-actions-snapshot.json",
    "diag:lsp": "node scripts/diagnostics/lsp-reusable-workflow.js",
    "diag:reusable-workflow": "esbuild scripts/diagnostics/repro-reusable-workflow.js --bundle --platform=node --format=cjs --outfile=node_modules/.cache/diagnostics/repro-reusable-workflow.cjs --log-level=error && node node_modules/.cache/diagnostics/repro-reusable-workflow.cjs",
    "depcruise:core": "depcruise --config .dependency-cruiser.core.cjs .",
    "depcruise:extras": "depcruise --config .dependency-cruiser.extras.cjs .",
    "depcruise:isolados": "depcruise --config .dependency-cruiser.isolados.cjs .",
    "test": "jest",
    "test:log": "node scripts/diagnostics/run-with-log.js logs/tests-output.log -- jest",
    "warm-routes": "node scripts/warm-routes.js",
    "warm:api": "node scripts/warm-routes.js --api",
    "precypress:run": "node scripts/warm-routes.js",
    "test:e2e": "npm run cypress:run",
    "test:e2e:isolated": "node scripts/e2e-isolated.js",
    "test:e2e:record": "npm run cypress:run -- --record --key \"$CYPRESS_RECORD_KEY\"",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --maxWorkers=2",
    "test:coverage:log": "node scripts/diagnostics/run-with-log.js logs/coverage-output.log -- jest --coverage --maxWorkers=2",
    "test:coverage:watch": "jest --coverage --watch",
    "test:ci": "jest --ci --coverage --bail",
    "test:db:container": "jest --config jest.config.db.js",
    "test:db:container:coverage": "jest --config jest.config.db.js --coverage",
    "test:db:unit": "jest --testPathPatterns='tests/unit/lib/db\\.test\\.js$'",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "db:init": "node scripts/init-server.js",
    "db:status": "node scripts/check-db-status.js",
    "db:shell": "node scripts/db-shell.js",
    "db:reset": "node scripts/reset-db.js && npm run db:init",
    "db:reset:password": "node scripts/reset-password.js",
    "db:reset:safe": "npm run backup:create && npm run db:reset",
    "db:clean:test": "node scripts/clean-test-db.js",
    "setup:test-db": "node scripts/setup-test-db.js",
    "backup:init": "node scripts/init-backup.js",
    "backup:create": "node scripts/create-backup.js",
    "backup:restore": "node scripts/restore-backup.js",
    "backup:logs": "node scripts/view-backup-logs.js",
    "backup:logs:all": "node scripts/view-backup-logs.js --all",
    "seed:all": "node scripts/seed-all.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "migrate:revert": "node scripts/migrate.js --revert",
    "cache:clear": "node scripts/clear-cache.js",
    "db:clear:musicas": "node scripts/clear-musicas.js",
    "db:clear": "node scripts/clear-db.js",
    "settings:update": "node scripts/utils/update-setting.js",
    "validate-schema": "node scripts/cli/validate-schema.js",
    "orders:expire": "node scripts/maintenance/expire-abandoned-orders.js",
    "mp:preflight": "node scripts/maintenance/check-mp-production-readiness.js",
    "monitor:disk": "node scripts/monitor-disk-space.js",
    "clean:reports": "node scripts/clean-k6-reports.js",
    "clean:images": "node scripts/clean-orphaned-images.js",
    "security:check-sql": "node scripts/check-sql-injection.js",
    "security:check-sql:all": "node scripts/check-sql-injection.js --all",
    "security:check-credentials": "node scripts/check-hardcoded-credentials.js",
    "security:check-credentials:all": "node scripts/check-hardcoded-credentials.js --all",
    "test:load:all": "node scripts/run-all-load-tests-sequentially.js",
    "test:load:all:log": "node scripts/diagnostics/run-with-log.js logs/load-tests.log -- node scripts/run-all-load-tests-sequentially.js",
    "test:load:orchestrator": "npm run test:load:all",
    "test:load:safe": "bash scripts/run-load-tests.sh",
    "report:load": "ADMIN_USERNAME=${ADMIN_USERNAME:-admin} ADMIN_PASSWORD=${ADMIN_PASSWORD} node scripts/generate-load-report.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caminhar-deus/Caminhar.git"
  },
  "keywords": [],
  "author": "Comunidade Caminhar <contato@caminhar.com.br>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/caminhar-deus/Caminhar/issues"
  },
  "homepage": "https://github.com/caminhar-deus/Caminhar#readme",
  "dependencies": {
    "@next/env": "^16.4.6",
    "@upstash/redis": "^1.41.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "formidable": "^3.5.4",
    "jsdom": "^31.0.1",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.5",
    "react-hot-toast": "^2.6.1",
    "sharp": "^0.35.5",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@actions/languageservice": "^0.3.62",
    "@actions/workflow-parser": "^0.3.62",
    "@babel/core": "^8.1.3",
    "@babel/eslint-parser": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^9.0.0",
    "@faker-js/faker": "^10.6.0",
    "@jest/globals": "^30.5.2",
    "@jest/reporters": "^30.5.2",
    "@testcontainers/postgresql": "^12.2.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "cypress": "^16.3.0",
    "dependency-cruiser": "^18.9.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-cypress": "^7.2.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-watch-typeahead": "^3.0.1",
    "knip": "^6.48.0",
    "next-sitemap": "^4.2.3",
    "node-mocks-http": "^1.18.1",
    "vscode-languageserver-textdocument": "^1.0.16",
    "vscode-uri": "^3.2.0",
    "wait-on": "^9.5.1",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "tar": "^7.4.3",
    "glob": "^13.0.6",
    "minimatch": "^10.2.2",
    "postcss": "^8.5.10",
    "uuid": "^14.0.0",
    "jsdom": "^31.0.1",
    "katex": "^0.18.2",
    "babel-preset-current-node-syntax": {
      "@babel/core": "^8.1.3"
    }
  },
  "_overridesReason": {
    "tar": "Correção de vulnerabilidade CVE em versões < 7.x",
    "glob": "Compatibilidade com versões mais recentes do pacote",
    "minimatch": "Correção de vulnerabilidade CVE e performance",
    "postcss": "Garantir versão compatível com Next.js",
    "uuid": "Segurança: versões antigas usavam Math.random()",
    "jsdom": "Sobe o jsdom aninhado no jest-environment-jsdom para ^31 (o ^30 já usa @exodus/bytes em vez do whatwg-encoding deprecado; o CSSOM próprio do ^31 resolve url() relativo no estilo computado)",
    "katex": "Segurança: GHSA-238p-pmpm-9mq7, corrigido na 0.18.2; só entra via @eslint/markdown (lint)",
    "babel-preset-current-node-syntax": "Plugins syntax-* do Jest 30 declaram peer @babel/core ^7; o projeto usa Babel 8 (ajuste só de declaração)"
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "sharp@0.35.5": true,
    "ssh2@1.17.0": true,
    "unrs-resolver@1.12.2": true,
    "protobufjs@7.6.6": true,
    "cypress@16.3.0": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true
  }
}
