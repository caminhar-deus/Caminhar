{
  "name": "caminhar",
  "version": "1.4.0",
  "description": "Plataforma web de conteúdo católico com Next.js",
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": "12.0.2"
  },
  "scripts": {
    "check-env": "node scripts/check-env.js",
    "dev": "npm run check-env && next dev --turbo",
    "build": "npm run check-env && next build --turbo",
    "postbuild": "next-sitemap",
    "start": "npm run check-env && next start",
    "dev:clean": "npx kill-port 3000 && rm -rf .next && rm -f babel.config.js babel.config.cjs && npm run dev",
    "analyze": "next build --analyze",
    "lint": "eslint .",
    "lint:log": "mkdir -p logs && bash -c 'set -o pipefail; eslint . 2>&1 | tee logs/eslint.log'",
    "lint:fix": "eslint . --fix",
    "lint:workflows": "bash scripts/diagnostics/lint-workflows.sh",
    "knip": "knip",
    "knip:watch": "knip --watch",
    "diag:lsp": "node scripts/diagnostics/lsp-reusable-workflow.js",
    "diag:reusable-workflow": "esbuild scripts/diagnostics/repro-reusable-workflow.js --bundle --platform=node --format=cjs --outfile=node_modules/.cache/diagnostics/repro-reusable-workflow.cjs --log-level=error && node node_modules/.cache/diagnostics/repro-reusable-workflow.cjs",
    "depcruise:core": "depcruise --config .dependency-cruiser.core.cjs .",
    "depcruise:extras": "depcruise --config .dependency-cruiser.extras.cjs .",
    "depcruise:isolados": "depcruise --config .dependency-cruiser.isolados.cjs .",
    "test": "jest",
    "test:log": "mkdir -p logs && bash -c 'set -o pipefail; jest 2>&1 | tee logs/tests-output.log'",
    "warm-routes": "node scripts/warm-routes.js",
    "warm:api": "node scripts/warm-routes.js --api",
    "precypress:run": "node scripts/warm-routes.js",
    "test:e2e": "npm run cypress:run",
    "test:e2e:record": "npm run cypress:run -- --record --key \"$CYPRESS_RECORD_KEY\"",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:log": "mkdir -p logs && bash -c 'set -o pipefail; jest --coverage 2>&1 | tee logs/coverage-output.log'",
    "test:coverage:watch": "jest --coverage --watch",
    "test:ci": "jest --ci --coverage --bail",
    "test:db:container": "jest --config jest.config.db.js",
    "test:db:container:coverage": "jest --config jest.config.db.js --coverage",
    "test:db:unit": "jest --testPathPatterns='tests/unit/lib/db\\.test\\.js$'",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "db:init": "node scripts/init-server.js",
    "db:status": "node scripts/check-db-status.js",
    "db:shell": "node scripts/db-shell.js",
    "db:reset": "node scripts/init-table.js posts && node scripts/init-table.js videos && node scripts/init-table.js musicas && node scripts/init-table.js dicas && npm run db:init",
    "db:reset:password": "node scripts/reset-password.js",
    "db:reset:safe": "npm run backup:create && npm run db:reset",
    "db:clean:test": "node scripts/clean-test-db.js",
    "backup:init": "node scripts/init-backup.js",
    "backup:create": "node scripts/create-backup.js",
    "backup:restore": "node scripts/restore-backup.js",
    "backup:logs": "node scripts/view-backup-logs.js",
    "backup:logs:all": "node scripts/view-backup-logs.js --all",
    "seed:all": "node scripts/seed-all.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "migrate:revert": "node scripts/migrate.js --revert",
    "cache:clear": "node scripts/clear-cache.js",
    "db:clear:musicas": "node scripts/clear-musicas.js",
    "db:clear": "node scripts/clear-db.js",
    "settings:update": "node scripts/utils/update-setting.js",
    "validate-schema": "node scripts/cli/validate-schema.js",
    "monitor:disk": "node scripts/monitor-disk-space.js",
    "clean:reports": "node scripts/clean-k6-reports.js",
    "clean:images": "node scripts/clean-orphaned-images.js",
    "security:check-sql": "node scripts/check-sql-injection.js",
    "security:check-sql:all": "node scripts/check-sql-injection.js --all",
    "test:load:all": "node scripts/run-all-load-tests-sequentially.js",
    "test:load:all:log": "mkdir -p logs && bash -c 'set -o pipefail; node scripts/run-all-load-tests-sequentially.js 2>&1 | tee logs/load-tests.log'",
    "test:load:orchestrator": "npm run test:load:all",
    "test:load:safe": "bash scripts/run-load-tests.sh",
    "report:load": "ADMIN_USERNAME=${ADMIN_USERNAME:-admin} ADMIN_PASSWORD=${ADMIN_PASSWORD} node scripts/generate-load-report.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caminhar-deus/Caminhar.git"
  },
  "keywords": [],
  "author": "Comunidade Caminhar <contato@caminhar.com.br>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/caminhar-deus/Caminhar/issues"
  },
  "homepage": "https://github.com/caminhar-deus/Caminhar#readme",
  "dependencies": {
    "@next/env": "^16.3.6",
    "@upstash/redis": "^1.39.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.4",
    "formidable": "^3.5.4",
    "jsdom": "^30.1.1",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-easy-crop": "^6.2.3",
    "react-hot-toast": "^2.6.1",
    "sharp": "^0.35.4",
    "web-vitals": "^6.2.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@actions/languageservice": "^0.3.61",
    "@actions/workflow-parser": "^0.3.61",
    "@babel/eslint-parser": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@eslint/markdown": "^8.0.3",
    "@faker-js/faker": "^10.6.0",
    "@jest/globals": "^30.5.2",
    "@jest/reporters": "^30.5.2",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "cypress": "^16.1.0",
    "dependency-cruiser": "^18.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-cypress": "^7.0.2",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-watch-typeahead": "^3.0.1",
    "knip": "^6.38.0",
    "next-sitemap": "^4.2.3",
    "node-mocks-http": "^1.18.1",
    "vscode-languageserver-textdocument": "^1.0.15",
    "vscode-uri": "^3.2.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "tar": "^7.4.3",
    "glob": "^13.0.6",
    "minimatch": "^10.2.2",
    "postcss": "^8.5.10",
    "uuid": "^14.0.0",
    "whatwg-encoding": "^3.1.1"
  },
  "_overridesReason": {
    "tar": "Correção de vulnerabilidade CVE em versões < 7.x",
    "glob": "Compatibilidade com versões mais recentes do pacote",
    "minimatch": "Correção de vulnerabilidade CVE e performance",
    "postcss": "Garantir versão compatível com Next.js",
    "uuid": "Segurança: versões antigas usavam Math.random()",
    "whatwg-encoding": "Correção de vulnerabilidade em versões < 3.x"
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "sharp@0.35.4": true,
    "ssh2@1.17.0": true,
    "unrs-resolver@1.12.2": true,
    "protobufjs@7.6.6": true,
    "cypress@16.1.0": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true
  }
}