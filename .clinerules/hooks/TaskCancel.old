#!/usr/bin/env bash
# Hook Cline: TaskCancel -> ai-memory: stop
#
# Instalação: renomeie para "TaskCancel" (sem extensão), coloque em
#   .clinerules/hooks/TaskCancel  ou  ~/Documents/Cline/Hooks/TaskCancel
# e rode: chmod +x TaskCancel
#
# Uma tarefa cancelada pelo usuário é tratada como "stop" (fim de turno
# interativo sem conclusão bem-sucedida). Não busca handoff nem bloqueia
# o cancelamento — é observabilidade pura.
set -u
LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$LIB_DIR/_ai_memory_cline_lib.sh"

amc_main "TaskCancel" "stop" 0
