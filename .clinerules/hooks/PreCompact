#!/usr/bin/env bash
# Hook Cline: PreCompact -> ai-memory: pre-compact
#
# Instalação: renomeie para "PreCompact" (sem extensão), coloque em
#   .clinerules/hooks/PreCompact  ou  ~/Documents/Cline/Hooks/PreCompact
# e rode: chmod +x PreCompact
#
# Dispara antes do Cline truncar/comprimir o histórico da conversa para
# liberar contexto. Avisa o ai-memory ANTES da perda de informação, para
# que qualquer observação relevante já capturada não dependa do que será
# descartado. Não bloqueia a compactação.
set -u
LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$LIB_DIR/_ai_memory_cline_lib.sh"

amc_main "PreCompact" "pre-compact" 0
