#!/usr/bin/env bash
# Hook Cline: TaskComplete -> ai-memory: session-end
#
# Instalação: renomeie para "TaskComplete" (sem extensão), coloque em
#   .clinerules/hooks/TaskComplete  ou  ~/Documents/Cline/Hooks/TaskComplete
# e rode: chmod +x TaskComplete
#
# Fecha o ciclo iniciado por TaskStart/TaskResume. No servidor ai-memory,
# um evento "session-end" verdadeiro sintetiza a página sessions/<id>.md
# e abre um Handoff para a próxima sessão (o que o TaskStart/TaskResume da
# PRÓXIMA tarefa irá consumir). Não precisa de handoff de volta aqui.
set -u
LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$LIB_DIR/_ai_memory_cline_lib.sh"

amc_main "TaskComplete" "session-end" 0
