#!/usr/bin/env bash
# Hook Cline: PostToolUse -> ai-memory: post-tool-use
#
# Instalação: renomeie para "PostToolUse" (sem extensão), coloque em
#   .clinerules/hooks/PostToolUse  ou  ~/Documents/Cline/Hooks/PostToolUse
# e rode: chmod +x PostToolUse
#
# Puramente observacional: o resultado da ferramenta já ocorreu e não pode
# ser desfeito por este hook. Registra nome da ferramenta + resultado + status
# de sucesso (o corpo é truncado em 16 KiB pelo próprio hook antes de enviar,
# e novamente a 2 KiB pelo servidor ai-memory para trechos de ferramenta)
# para consolidação posterior via memory_consolidate.
set -u
LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$LIB_DIR/_ai_memory_cline_lib.sh"

RAW="$(amc_read_stdin)"
# O Cline envia os dados deste evento no bloco aninhado "postToolUse"
# (toolName, parameters, result, success, executionTimeMs) — não em
# "toolResponse"/"tool_response"/"output" soltos no topo do JSON.
TOOL_NAME="$(amc_jget "$RAW" '.postToolUse.toolName')"
TOOL_OUTPUT="$(amc_jget "$RAW" '.postToolUse.result // (.postToolUse.parameters | tostring)')"
TOOL_SUCCESS="$(amc_jget "$RAW" '.postToolUse.success')"

ENVELOPE="$(amc_build_envelope "$RAW" "post-tool-use" "PostToolUse" "$TOOL_NAME $TOOL_OUTPUT (success=$TOOL_SUCCESS)")"
amc_send "$ENVELOPE" "post-tool-use" >/dev/null

amc_emit_result "" false ""
