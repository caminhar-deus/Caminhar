      //                         medição do estreante de 21/10 — reavaliar em rodada futura;
      //                         não confundir com o gatilho de fila da observação de campo.
      "explorer":     { "model": "opencode/deepseek-v4.1-flash-free" },
      // designer: 18/10/2026, muse-spark-1.3-contributor-free SAIU do catálogo do Zen e o agente
      // parou de funcionar (o host rejeita o spawn: "Model ... is not available"). Trocado para
