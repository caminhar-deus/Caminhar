# ==========================================
# Variáveis Obrigatórias
# ==========================================

# Conexão com o banco de dados PostgreSQL
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Exemplo local (cluster PostgreSQL nativo na porta padrão): postgresql://caminhar:SUA_SENHA_AQUI@localhost:5432/caminhar
# A porta 5432 é a padrão do PostgreSQL. Use outra porta apenas se o seu cluster
# estiver configurado para escutar em outra (verifique com: ss -ltn | grep 543).
DATABASE_URL="postgresql://caminhar:SUA_SENHA_AQUI@localhost:5432/caminhar"

# SSL da conexão com o PostgreSQL (não depende de NODE_ENV)
# "true"/"1" = SSL sem validar o certificado (auto-assinado); "false"/"0" = sem SSL;
# ausente = não passa `ssl` ao driver, que então respeita o `sslmode` da DATABASE_URL.
#
# ATENÇÃO — `sslmode=` na URL VENCE o DATABASE_SSL. No driver, a connectionString é
# aplicada por último (`Object.assign({}, config, parse(url))` em
# `pg/lib/connection-parameters.js`), então o `sslmode` sobrescreve a opção `ssl`.
# Testado: `?sslmode=require` ganha de `DATABASE_SSL="false"`, e `?sslmode=disable`
# ganha de `DATABASE_SSL="true"`. Com os dois presentes, o DATABASE_SSL é um no-op
# silencioso — e o app emite um warning explicando isso.
#
# PORTANTO: escolha UM mecanismo. Se a URL tiver `sslmode`, defina o modo só lá e
# deixe DATABASE_SSL vazio. Se a URL não tiver, defina DATABASE_SSL aqui.
# Sem nenhum dos dois, a conexão sai sem SSL.
#
# Verificação: `psql "$DATABASE_URL" -c "SHOW ssl;"` — precisa responder `on`.
DATABASE_SSL=""

# Chave secreta para assinar tokens JWT
# Em produção, use uma string longa e aleatória (ex: execute `openssl rand -hex 32` no terminal)
JWT_SECRET="sua-chave-jwt-aqui"

# Chave de criptografia para backups (32 caracteres recomendados)
BACKUP_ENCRYPTION_KEY="sua-chave-criptografia-aqui"

# ==========================================
# Variáveis Opcionais
# ==========================================

# Credenciais iniciais do administrador
# Se não definidas, o sistema pode usar padrões (admin/password) ou falhar em certas verificações de segurança
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="sua-senha-admin-aqui"

# Configuração do Redis (Upstash) para Rate Limiting persistente
# Se não definido, o Rate Limit funcionará em memória (reinicia com o servidor)
UPSTASH_REDIS_REST_URL="https://seu-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="seu-token-upstash-aqui"

# Whitelist de IPs para o Rate Limit
# Lista de IPs separados por vírgula que nunca serão bloqueados pelo middleware de segurança
ADMIN_IP_WHITELIST="127.0.0.1,::1"

# Quantos proxies confiáveis existem entre o cliente e a aplicação (Nginx, LB etc.)
# Ausente ou "false" = 0 (o header X-Forwarded-For é ignorado e vale o IP do socket);
# "true" = 1 (um único proxy reverso); um inteiro N = N proxies.
# O X-Forwarded-For é lido pela direita (a N-ésima entrada), então o cliente não
# consegue forjar a própria identidade.
TRUST_PROXY="false"

# URL base do site para geração de Sitemap e SEO
SITE_URL="http://localhost:3000"

# Configuração de CORS (para API pública v1)
# Lista de origens permitidas separadas por vírgula
ALLOWED_ORIGINS="http://localhost:3000,https://seu-dominio.com"

# Ambiente de execução (development, production, test)
NODE_ENV="development"

# Diretório onde os uploads de imagem são gravados (ativo)
# Padrão quando ausente/vazio: <raiz-do-repo>/uploads — fora de `public/` de
# propósito: o `next start` tira um snapshot de `public/` no início do processo e
# não serve arquivo gravado em runtime (a URL pública continua `/uploads/<arquivo>`).
# Em deploy com filesystem efêmero (container), o uso típico é apontar para um
# volume persistente (ex.: UPLOADS_DIR="/var/data/uploads").
# Em desenvolvimento, deixe ausente/vazia — o default basta.
UPLOADS_DIR=""