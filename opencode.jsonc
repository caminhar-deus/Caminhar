{
  // OpenCode — configuração do PROJETO (mescla com ~/.config/opencode/opencode.json; o projeto vence).
  // Formato v2 (servidores MCP em "mcp.servers.<nome>" com "disabled"). Ver docs de compatibilidade em ~/projetos/lab-opencode-stack/docs/COMPATIBILIDADE.md.
  // Para ver o resultado já mesclado: `opencode debug config`.
  "$schema": "https://opencode.ai/config.json",

  // --- Privacidade e controle ---
  "share": "disabled",          // sem links públicos de sessão
  "autoupdate": false,          // use "notify" se quiser apenas ser avisado
  // Só carrega os provedores listados (cloud e Zen não são carregados mesmo com chaves no ambiente).
  // "opencode" = OpenCode Zen, necessário para o modelo mimo-v2.6-flash-free. "ollama" fica como base local.
  // ATENÇÃO: com "opencode" ativo, prompts/código vão a servidores remotos (EUA) e, neste modelo free,
  // os dados podem ser usados para melhorar o modelo. Para voltar 100% local: deixe só ["ollama"].
  // Para um preset híbrido, acrescente o provedor aqui (ex.: "openai").
  "enabled_providers": ["ollama", "opencode"],

  // --- Modelos (TROQUE pelos nomes de `ollama list` / `opencode models`) ---
  // ATIVO: OpenCode Zen (remoto; free por tempo limitado). Formato: opencode/<model-id>.
  // Sessão segue o orchestrator do preset "zen" (Cenário 3 privacidade): space-bunny = zero-retention.
  // small_model (títulos etc.) = mimo-v2.6-flash-free (leve). Login via `/connect` > OpenCode Zen ou OPENCODE_API_KEY.
  "model": "opencode/space-bunny-free",
  "small_model": "opencode/mimo-v2.6-flash-free",
  // Para voltar ao Ollama local: comente as 2 linhas acima e descomente as 2 abaixo.
  // "model": "ollama/qwen3-coder:30b",
  // "small_model": "ollama/qwen3-coder:30b",   // títulos etc. também locais

  // Base OLLAMA mantida sem alterações (só é usada se selecionada em /models ou ao voltar "model" para ollama/...).
  // O provedor "opencode" (Zen) é nativo: não precisa de bloco aqui.
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        // Modelos locais lentos: evite abortar por tempo. false desliga o limite.
        "timeout": 600000,
        "chunkTimeout": 120000
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3-Coder 30B (local)",
          // Ajuste ao que a VRAM/RAM aguenta e configure o mesmo num_ctx no Ollama (16k-32k no mínimo).
          "limit": { "context": 32768, "output": 8192 }
        }
      }
    }
    // Alternativas (mesmo padrão): llama-server http://127.0.0.1:8080/v1 ; LM Studio http://127.0.0.1:1234/v1
  },

  // --- Permissões: o padrão do OpenCode é permitir quase tudo. Aqui é restritivo; afrouxe com o tempo. ---
  // Regras: a ÚLTIMA que casar vence (catch-all "*" primeiro). Comandos com argumentos precisam de "*".
  "permission": {
    "edit": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls*": "allow",
      "grep *": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "git push *": "deny",
      "git reset --hard*": "deny",
      // T8 (04/10/2026): o matcher casa por início de segmento; estes 2 escapes passavam pelos denies acima.
      // Limite conhecido: padrão de string NÃO é sandbox (`env git push`, `sh -c`, etc. continuam possíveis).
      "git -C * push *": "deny",
      "bash -c *": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny"
    }
    // external_directory e doom_loop já são "ask" por padrão.
  },

  // --- Permissões por agente ---
  // O campo "permission" do bloco "agents" do .opencode/oh-my-opencode-slim.json NÃO é aplicado aos
  // papéis built-in neste host: o slim emite as regras com a ação "bash", e o OpenCode v2 compila a
  // ferramenta de terminal como "shell". Além disso, as regras do slim entram ANTES do "permission"
  // global deste arquivo, e vale a última que casar — um "deny" do slim é sobreposto pelo "ask" daqui.
  // Por isso a trava dos agentes apenas-leitura fica AQUI, no config do host, declarada por último.
  // Conferir com `opencode debug agents`: as regras deste bloco aparecem no fim da lista compilada.
  // "edit" cobre toda mutação de arquivo (não existem "write"/"apply_patch" no host);
  // "ast_grep_replace" é a ferramenta de rewrite do ast-grep, injetada e sem equivalente no host.
  //
  // "bash" NÃO pode ser negado aqui. Medido em 09/10/2026: com "bash": "deny", explorer, librarian e
  // oracle caem com "OpenCode's free tier can only be used from within OpenCode" no primeiro turno,
  // e a cadeia de fallback não salva — o modelo de reserva cai igual, porque o bloqueio vem do desvio
  // de rota, não do modelo. Sem o "deny", os três funcionam; designer e fixer nunca tiveram o "deny"
  // e funcionaram com o mesmo provedor e o mesmo modelo. O terminal desses três volta a ser governado
  // pelo "permission" global acima ("bash": {"*": "ask"}), inclusive com os escapes de git push e
  // "bash -c *" negados.
  "agent": {
    "explorer":  { "permission": { "edit": "deny", "ast_grep_replace": "deny" } },
    "librarian": { "permission": { "edit": "deny", "ast_grep_replace": "deny" } },
    "oracle":    { "permission": { "edit": "deny", "ast_grep_replace": "deny" } }
  },

  // --- Contexto e desempenho no WSL ---
  "compaction": { "auto": true, "prune": true },
  "watcher": { "ignore": ["node_modules/**", "dist/**", ".git/**", ".slim/clonedeps/repos/**"] },
  // Se o repositório for grande e o disco/WSL sofrer, considere "snapshot": false (perde o undo pela UI).

  // Formato v2: servidores em "mcp.servers", com "disabled" (não "enabled").
  "mcp": {
    // Front-End-Checklist (MCP REMOTO). DESLIGADO: review_code envia código ao servidor deles.
    // Ligue só numa sessão consciente. Alternativa local: a skill frontend-checklist-global (concedida ao oracle no slim).
    "servers": {
      "frontend-checklist": {
        "type": "remote",
        "url": "https://mcp.frontendchecklist.io",
        "disabled": true
      }
    }
    // ai-memory: não escreva à mão; use `ai-memory install-mcp --client opencode --apply`.
  }

  // "plugin": o instalador do slim registra a entrada. Depois, FIXE a versão (ex.: "oh-my-opencode-slim@X.Y.Z").
  // Não rode `opencode serve/web` com "hostname": "0.0.0.0" ou "mdns": true sem entender o risco (docs/PRIVACIDADE.md).
}
